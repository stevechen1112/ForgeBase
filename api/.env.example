# ===========================
# Database
# ===========================
DATABASE_URL=postgresql+asyncpg://forgebase:forgebase_dev@localhost:5432/forgebase

# ===========================
# Security
# ===========================
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===========================
# LLM Provider
# ===========================
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=AIza...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL_NAME=gemini-3-flash-preview

# ===========================
# Cloudflare R2
# ===========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forgebase-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# ===========================
# Resend (Email)
# ===========================
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ForgeBase

# ===========================
# App
# ===========================
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================
# First Admin User (seed)
# ===========================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password

# ===========================
# Service Account Tokens (machine-to-machine auth, e.g. ContentFlow)
# ===========================
# Format: comma-separated "token:user_id" pairs
# 1. Create a user in ForgeBase with role=marketing_manager and a tenant_id
# 2. Generate a random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Map: SERVICE_ACCOUNT_TOKENS=<token>:<user_id>
# ContentFlow uses X-API-Key header to authenticate
SERVICE_ACCOUNT_TOKENS=

# ===========================
# AI Marketing Copilot �X Telegram Notifications
# ===========================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Random secret for webhook HMAC validation (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
TELEGRAM_WEBHOOK_SECRET=
