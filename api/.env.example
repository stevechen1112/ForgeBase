# ===========================
# Database
# ===========================
DATABASE_URL=postgresql+asyncpg://forgebase:forgebase_dev@localhost:5432/forgebase

# ===========================
# Security
# ===========================
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===========================
# OpenAI
# ===========================
OPENAI_API_KEY=sk-...
AI_MODEL_NAME=gpt-5.4

# ===========================
# Cloudflare R2
# ===========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forgebase-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# ===========================
# Resend (Email)
# ===========================
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ForgeBase

# ===========================
# App
# ===========================
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================
# First Admin User (seed)
# ===========================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password
