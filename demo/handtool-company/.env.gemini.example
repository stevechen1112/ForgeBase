# Gemini image generation for NorthForge demo assets
# Copy this file to .env.gemini and fill in the real key locally.

# Required
GEMINI_API_KEY=your-gemini-api-key-here

# Recommended model for first-pass batch image generation
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Output control
GEMINI_IMAGE_OUTPUT_DIR=demo/handtool-company/assets/generated
GEMINI_IMAGE_DEFAULT_ASPECT_RATIO=16:9
GEMINI_IMAGE_DEFAULT_RESOLUTION=1K

# Batch behavior
GEMINI_IMAGE_BATCH_SIZE=4
GEMINI_IMAGE_ENABLE_THOUGHTS=false
GEMINI_IMAGE_THINKING_LEVEL=MINIMAL

# Demo scope
GEMINI_IMAGE_PROFILE=northforge-demo
GEMINI_IMAGE_TARGET_SET=minimum-demo