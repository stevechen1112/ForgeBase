# ===========================
# King-A 獨立實例 — 環境變數
# 複製此檔為 .env 並填入實際值
# ===========================

# ===========================
# Database (獨立 DB，不共用 demo)
# ===========================
DATABASE_URL=postgresql+asyncpg://forgebase_kinga:kinga_dev_2026@db-kinga:5432/forgebase_kinga

# Ports (與 demo 錯開)
DB_PORT=5433
API_PORT=8001
WEB_PORT=3002
ADMIN_PORT=3003

# ===========================
# Security
# ===========================
SECRET_KEY=kinga-change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===========================
# OpenAI (共用同一把 key 即可)
# ===========================
OPENAI_API_KEY=sk-...
AI_MODEL_NAME=gpt-5.4

# ===========================
# Cloudflare R2
# ===========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forgebase-kinga-assets
R2_PUBLIC_URL=https://assets.king-a-growth.com

# ===========================
# Resend (Email)
# ===========================
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@king-a-growth.com
EMAIL_FROM_NAME=King-A 欣榮焊接

# ===========================
# App — King-A 專屬網域
# ===========================
APP_ENV=development
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003

# ===========================
# Site Identity (King-A 品牌)
# ===========================
NEXT_PUBLIC_SITE_NAME=King-A 欣榮焊接
NEXT_PUBLIC_SITE_DOMAIN=king-a-growth.com
NEXT_PUBLIC_SITE_DESCRIPTION=專業焊接與切割解決方案
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================
# First Admin User
# ===========================
ADMIN_EMAIL=admin@king-a.com.tw
ADMIN_PASSWORD=change-this-password
