# Gemini image generation for ForgeBase sales/marketing page assets
# Copy this file to .env.gemini and fill in the real key locally.

# Required
GEMINI_API_KEY=your-gemini-api-key-here

# Model
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Output control — images saved under assets/sales-page/generated/
GEMINI_IMAGE_OUTPUT_DIR=assets/sales-page/generated
GEMINI_IMAGE_DEFAULT_ASPECT_RATIO=16:9
GEMINI_IMAGE_DEFAULT_RESOLUTION=1K

# Batch behavior
GEMINI_IMAGE_BATCH_SIZE=4
GEMINI_IMAGE_ENABLE_THOUGHTS=false
GEMINI_IMAGE_THINKING_LEVEL=MINIMAL

# Scope
GEMINI_IMAGE_PROFILE=forgebase-sales-page
GEMINI_IMAGE_TARGET_SET=sales-page
