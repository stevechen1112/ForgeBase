# 前台 API 連線
NEXT_PUBLIC_API_URL=http://localhost:8000

# 在 mock-only 本地環境（不啟動後端）設為 true，避免 tracking/chat 發出
# ERR_CONNECTION_REFUSED 的 console 噪音。生產環境請保持 false 或不設定。
NEXT_PUBLIC_TRACKING_DISABLED=false

# 關閉前台 AI chat widget，適合純靜態 demo / mock-only 環境
NEXT_PUBLIC_CHAT_DISABLED=false

# Cloudflare R2 Public URL hostname（供 next/image 使用）
R2_PUBLIC_HOSTNAME=assets.example.com

# 網站基本資訊
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ForgeBase
