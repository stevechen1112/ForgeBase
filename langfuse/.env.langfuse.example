# ─────────────────────────────────────────────────────────────────────────────
# Langfuse v3 — ForgeBase self-hosted configuration
#
# Copy this file to .env.langfuse and fill ALL values marked CHANGE_ME.
# Never commit the filled-in .env.langfuse to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (NextAuth.js) ────────────────────────────────────────────────────────
# Generate both with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_run_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3030

# Encryption salt for sensitive data stored in Postgres
# Generate: openssl rand -base64 32
SALT=CHANGE_ME_run_openssl_rand_base64_32

# ── Database ──────────────────────────────────────────────────────────────────
LANGFUSE_DB_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgresql://langfuse:CHANGE_ME_strong_db_password@langfuse-db:5432/langfuse

# ── ClickHouse ────────────────────────────────────────────────────────────────
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE_ME_strong_clickhouse_password
CLICKHOUSE_MIGRATION_URL=clickhouse://langfuse:CHANGE_ME_strong_clickhouse_password@langfuse-clickhouse:9000
CLICKHOUSE_URL=http://langfuse-clickhouse:8123
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=CHANGE_ME_strong_clickhouse_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=langfuse-redis
REDIS_PORT=6379
# REDIS_AUTH=CHANGE_ME_if_you_add_requirepass_to_redis

# ── Blob / S3 storage ─────────────────────────────────────────────────────────
# Langfuse uses blob storage as a write-ahead buffer for incoming traces.
# By default it uses the filesystem (fine for dev / low-volume).
# For production, point it at Cloudflare R2 — you already have R2 in ForgeBase.
#
# LANGFUSE_S3_EVENT_UPLOAD_ENABLED=true
# LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-traces
# LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
# LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=CHANGE_ME
# LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME
#
# LANGFUSE_S3_MEDIA_UPLOAD_ENABLED=true
# LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media
# LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=CHANGE_ME
# LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME

# ── Headless initialisation ───────────────────────────────────────────────────
# Runs automatically on first boot. Creates the org, project, and admin user.
# Idempotent — safe to leave in place across restarts.

# Organisation
LANGFUSE_INIT_ORG_ID=forgebase-org
LANGFUSE_INIT_ORG_NAME=ForgeBase

# Project (one per environment is recommended: prod / staging / dev)
LANGFUSE_INIT_PROJECT_ID=forgebase-prod
LANGFUSE_INIT_PROJECT_NAME=ForgeBase Production

# SDK API keys for this project.
# These values are what you set in api/.env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
# Generate any alphanumeric strings, or let Langfuse UI regenerate them after first boot.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGE_ME_public_key
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGE_ME_secret_key

# First admin account
LANGFUSE_INIT_USER_EMAIL=admin@your-domain.com
LANGFUSE_INIT_USER_NAME=ForgeBase Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_strong_admin_password

# ── Telemetry ─────────────────────────────────────────────────────────────────
# Disable anonymous usage stats sent to Langfuse GmbH.
TELEMETRY_ENABLED=false

# ── Email (optional — for password reset and team invites) ───────────────────
# SMTP_CONNECTION_URL=smtps://user:password@smtp.example.com:465

# ── UI port (used by docker-compose.langfuse.yml) ────────────────────────────
LANGFUSE_PORT=3030
