# ForgeBase 生產環境 — Docker Compose 變數
# 複製為 repo 根目錄的 .env（docker compose 只會自動讀根目錄 .env）

# 正式網域與目前 Linode 公開 IP。
PROTOCOL=https
DOMAIN=pcbrm.tw
# IP 入口會永久轉址至 DOMAIN。
APEX_DOMAIN=172.233.64.5

# PostgreSQL（容器內部署，僅內部網路可達，不對外暴露 port）
POSTGRES_USER=forgebase
POSTGRES_PASSWORD=CHANGE_ME_請用強密碼
POSTGRES_DB=forgebase

# Web 前台 ISR revalidate 密鑰：與 deploy/api.env 的 WEB_REVALIDATE_SECRET 必須相同
REVALIDATE_SECRET=CHANGE_ME_與_api_env_相同

# Web 前台建置參數
# 留空＝前台不送 X-Tenant-ID。API 會回 tenant_id IS NULL 的內容，也就是 seed 匯入的資料。
# 填了不相符的租戶 slug 會讓前台查到 0 筆內容（頁面與圖片全空），除非內容已歸屬該租戶。
NEXT_PUBLIC_TENANT_SLUG=
NEXT_PUBLIC_SITE_NAME=NorthForge Tools

# Optional Cloudflare Turnstile public site key. Keep blank until a widget is configured.
TURNSTILE_SITE_KEY=

# Optional external AgentOS base URL. Leave blank to skip this outbox action.
AGENTOSS_URL=
