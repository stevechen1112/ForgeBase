# ForgeBase API — 生產環境變數（secrets）
# 複製為 deploy/api.env 並填妥。DATABASE_URL / FRONTEND_URL / ALLOWED_ORIGINS 等
# 由 docker-compose.prod.yml 依根目錄 .env 的 DOMAIN、POSTGRES_* 自動組裝，這裡不用設。

APP_ENV=production

# JWT 簽章密鑰：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME

# OpenAI（本系統僅使用 OpenAI LLM）
OPENAI_API_KEY=sk-CHANGE_ME
AI_MODEL_NAME=gpt-5.6-luna
CHAT_ENABLED=true
CHAT_SESSION_MESSAGE_LIMIT=20
CHAT_DAILY_TENANT_MESSAGE_LIMIT=500
CHAT_LLM_TIMEOUT_SECONDS=20
PUBLIC_TENANT_SLUG=default-tenant

# 整合憑證加密（production 必填）：python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_MASTER_KEY=CHANGE_ME

# Web 前台 on-demand revalidate 密鑰（與 web 的 REVALIDATE_SECRET 相同；見 README）
# 目標網址由 docker-compose.prod.yml 的 WEB_REVALIDATE_URLS 組裝，這裡只放密鑰。
WEB_REVALIDATE_SECRET=CHANGE_ME

# 開放註冊密鑰：留空 = 關閉公開註冊（建議留空，用 seed 腳本建帳號）
REGISTRATION_KEY=

# Public form hardening and analytics retention
RFQ_BOT_CHALLENGE_REQUIRED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=pcbrm.tw,axisform.172-233-64-5.sslip.io
TURNSTILE_EXPECTED_ACTION=rfq_submit
ANALYTICS_RETENTION_DAYS=180
CONSENT_POLICY_VERSION=2026-08-15
# Comma-separated CIDRs of the deployment's own reverse proxies. Leave empty
# to ignore X-Forwarded-For and use the direct peer address.
TRUSTED_PROXY_CIDRS=

# Company identification POC. Register pdl_ip only after OEM/data rights are
# approved and the contracted per-match cost is known.
PDL_API_KEY=
PDL_DATA_USE_APPROVED=false
PDL_IP_ENRICH_ESTIMATED_COST=0
PDL_CONTACT_DATA_USE_APPROVED=false
PDL_CONTACT_ESTIMATED_COST=0
APOLLO_API_KEY=
APOLLO_DATA_USE_APPROVED=false
APOLLO_CONTACT_ESTIMATED_COST=0
HUNTER_API_KEY=
HUNTER_DATA_USE_APPROVED=false
HUNTER_CONTACT_ESTIMATED_COST=0
HUNTER_VERIFY_ESTIMATED_COST=0
COMPANY_PROVIDER_TIMEOUT_SECONDS=8
COMPANY_PROVIDER_CIRCUIT_FAILURES=5
COMPANY_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=300

# Optional incident webhook (Slack/Teams-compatible relay or custom endpoint)
OPS_ALERT_WEBHOOK_URL=
OPS_FAILED_JOB_ALERT_THRESHOLD=1
OPS_STALE_JOB_MINUTES=15
OPS_ALERT_COOLDOWN_MINUTES=60
EXTERNAL_MONITOR_NAME=

# ---- 選填 ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# ESP_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=whsec_...
# EMAIL_FROM=notifications@your-verified-domain.example
# EMAIL_FROM_NAME=ForgeBase
# EMAIL_DRY_RUN=true   # demo/reference sites: exercise flow without contacting the ESP
# EMAIL_EXTERNAL_DELIVERY_ENABLED=false  # keep false during external testing
# OUTREACH_SEND_ENABLED=false            # independent North Star kill switch
# OUTREACH_PUBLIC_BASE_URL=https://api.example.com
# OUTREACH_UNSUBSCRIBE_SECRET=            # generate a distinct high-entropy secret
# OUTREACH_UNSUBSCRIBE_TOKEN_DAYS=365
# INBOUND_REPLY_ENABLED=false             # independent inbound processing kill switch
# OUTREACH_INBOUND_DOMAIN=replies.example.com
# OUTREACH_INBOUND_SECRET=                # distinct high-entropy route-signing secret
# INBOUND_REPLY_MAX_WEBHOOK_BYTES=262144
# INBOUND_REPLY_MAX_FETCH_BYTES=1048576
# INBOUND_REPLY_MAX_BODY_CHARS=50000
# INBOUND_REPLY_MAX_ATTACHMENTS=20
# INBOUND_REPLY_MAX_ATTACHMENT_BYTES=26214400
# EMAIL_INTERNAL_RECIPIENT_ALLOWLIST=ops@your-company.example
# EMAIL_TEST_RECIPIENT_ALLOWLIST=delivered@resend.dev
# SALES_NOTIFY_EMAIL=  # internal team inbox only; never use a lead address here
# MANAGER_EMAIL=       # internal escalation inbox only
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=forgebase-assets
# R2_PUBLIC_URL=https://assets.example.com
# SYNTHETIC_TEST_TOKEN=  # generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BACKUP_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_BUCKET_NAME=forgebase-backups
# BACKUP_ENCRYPTION_KEY=  # URL-safe base64 of exactly 32 random bytes

# Optional external AgentOS. Leave blank unless a real /tasks endpoint exists.
AGENTOSS_URL=
