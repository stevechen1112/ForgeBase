# ForgeBase API — 生產環境變數（secrets）
# 複製為 deploy/api.env 並填妥。DATABASE_URL / FRONTEND_URL / ALLOWED_ORIGINS 等
# 由 docker-compose.prod.yml 依根目錄 .env 的 DOMAIN、POSTGRES_* 自動組裝，這裡不用設。

APP_ENV=production

# JWT 簽章密鑰：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME

# OpenAI（本系統僅使用 OpenAI LLM）
OPENAI_API_KEY=sk-CHANGE_ME
AI_MODEL_NAME=gpt-5.6-luna
CHAT_ENABLED=true
CHAT_SESSION_MESSAGE_LIMIT=20
CHAT_DAILY_TENANT_MESSAGE_LIMIT=500
CHAT_LLM_TIMEOUT_SECONDS=20
PUBLIC_TENANT_SLUG=default-tenant

# 整合憑證加密（production 必填）：python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_MASTER_KEY=CHANGE_ME

# Web 前台 on-demand revalidate 密鑰（與 web 的 REVALIDATE_SECRET 相同；見 README）
WEB_REVALIDATE_SECRET=CHANGE_ME

# 開放註冊密鑰：留空 = 關閉公開註冊（建議留空，用 seed 腳本建帳號）
REGISTRATION_KEY=

# ---- 選填 ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# RESEND_API_KEY=
# EMAIL_DRY_RUN=true   # demo closed-loop without ESP key (logs instead of sending)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_HOSTNAME=
