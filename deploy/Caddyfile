# apex（mitselect.com）永久導向 www
{$APEX_DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# web 前台自己的 /api 路由（ISR revalidate、素材自檢），必須比 /api/* 先匹配
	@web_api path /api/revalidate /api/health/*
	handle @web_api {
		reverse_proxy web:3000
	}

	# FastAPI：API 主體、本機上傳素材、健康檢查
	@api path /api/* /uploads/* /health
	handle @api {
		reverse_proxy api:8000
	}

	# Admin 後台（Next.js basePath=/backend，靜態資產也在 /backend 下）
	handle /backend* {
		reverse_proxy admin:3000
	}

	# 其餘全部給 Web 前台
	handle {
		reverse_proxy web:3000
	}
}
