# pcbrm.tw is the canonical site. The public IP only remains as a redirect.
# HTTP stays explicit so local health checks remain available during TLS renewal.
{
	default_sni {$DOMAIN}
	auto_https disable_redirects
	on_demand_tls {
		ask http://api:8000/internal/tls/authorize
	}
}

(forgebase_routes) {
	encode zstd gzip

	# Guard the legacy CMS asset path so it cannot fall through to marketing.
	@legacy_demo_assets path /demo/handtool-company/assets/*
	handle @legacy_demo_assets {
		rewrite * /northforge-tools{uri}
		reverse_proxy web_reference:3000
	}

	# These are Next.js application routes, not shared FastAPI routes.
	@web_api path /api/revalidate /api/health/*
	handle @web_api {
		rewrite * /northforge-tools{uri}
		reverse_proxy web_reference:3000
	}

	@api path /api/* /uploads/* /health /health/*
	handle @api {
		reverse_proxy api:8000
	}

	handle /backend* {
		reverse_proxy admin:3000
	}

	handle /templates* {
		reverse_proxy templates:80
	}

	handle /northforge-tools* {
		reverse_proxy web_reference:3000
	}

	handle {
		reverse_proxy marketing:3020
	}
}

(tenant_routes) {
	encode zstd gzip

	@web_api path /api/revalidate /api/health/*
	handle @web_api {
		reverse_proxy web:3000 {
			header_up -X-ForgeBase-Tenant-Host
			header_up -X-ForgeBase-Routing-Secret
		}
	}

	@api path /api/* /uploads/* /health /health/*
	handle @api {
		reverse_proxy api:8000 {
			header_up -X-ForgeBase-Tenant-Host
			header_up -X-ForgeBase-Routing-Secret
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up -X-ForgeBase-Tenant-Host
			header_up -X-ForgeBase-Routing-Secret
		}
	}
}

:80 {
	@local_health {
		host 127.0.0.1 localhost
		path /health /health/*
	}
	handle @local_health {
		reverse_proxy api:8000
	}
	@platform_entry host {$DOMAIN} www.{$DOMAIN} {$APEX_DOMAIN}
	handle @platform_entry {
		redir https://{$DOMAIN}{uri} permanent
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

https://{$DOMAIN} {
	import forgebase_routes
}

https://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

https://{$APEX_DOMAIN} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}
	redir https://{$DOMAIN}{uri} permanent
}

# All platform-provided and verified custom domains share one frontend image.
# Caddy asks the indexed API allowlist before issuing any on-demand certificate.
https:// {
	tls {
		on_demand
	}
	import tenant_routes
}
