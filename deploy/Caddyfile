# 正式環境沒有網域，直接為公開 IP 申請 Let's Encrypt shortlived 憑證。
# 明確保留 HTTP site，憑證申請或更新期間仍可進行健康檢查。
{
	# 多數用戶端連線 IP 時不傳 SNI；指定預設名稱才能選中 IP 憑證。
	default_sni {$DOMAIN}
	# 保留下方明確定義的本機 HTTP health route，其餘流量手動導向 HTTPS。
	auto_https disable_redirects
}

(forgebase_routes) {
	encode zstd gzip

	@web_api path /api/revalidate /api/health/*
	handle @web_api {
		reverse_proxy web:3000
	}

	@api path /api/* /uploads/* /health /health/*
	handle @api {
		reverse_proxy api:8000
	}

	handle /backend* {
		reverse_proxy admin:3000
	}

	handle {
		reverse_proxy web:3000
	}
}

:80 {
	@local_health {
		host 127.0.0.1 localhost
		path /health
	}
	handle @local_health {
		reverse_proxy api:8000
	}
	handle {
		redir https://{$DOMAIN}{uri} permanent
	}
}

https://{$DOMAIN} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}
	import forgebase_routes
}
