# IP 直連模式：純 HTTP 80
:80 {
	encode zstd gzip

	# web 前台自己的 /api 路由（ISR revalidate、素材自檢），必須比 /api/* 先匹配
	@web_api path /api/revalidate /api/health/*
	handle @web_api {
		reverse_proxy web:3000
	}

	@api path /api/* /uploads/* /health
	handle @api {
		reverse_proxy api:8000
	}

	handle /backend* {
		reverse_proxy admin:3000
	}

	handle {
		reverse_proxy web:3000
	}
}
